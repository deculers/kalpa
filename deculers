--========================================================--
-- ULTRA BLANK + EXTREME PERFORMANCE
-- + AUTO HILANGKAN POPUP IKAN
-- CHARACTER INVISIBLE
-- Roblox Studio / LocalScript
--========================================================--

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer

--========================================================--
-- SETTINGS
--========================================================--

local WORLD_INVISIBLE = true
local WORLD_TRANSPARENCY = 1

local DISABLE_VFX = true
local DISABLE_LIGHTS = true
local DISABLE_SHADOWS = true
local HIDE_TEXTURES = true

local HIDE_CHARACTER = true
local REMOVE_ACCESSORIES = true

local HIDE_FISH_POPUP = true

--========================================================--
-- LIGHTING
--========================================================--

pcall(function()
	Lighting.GlobalShadows = false
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	Lighting.Brightness = 1
end)

for _, obj in ipairs(Lighting:GetChildren()) do
	if obj:IsA("PostEffect") then
		pcall(function()
			obj.Enabled = false
		end)
	end
end

--========================================================--
-- TERRAIN
--========================================================--

local Terrain = Workspace:FindFirstChildOfClass("Terrain")

if Terrain then
	pcall(function()
		Terrain.Decoration = false
		Terrain.WaterWaveSize = 0
		Terrain.WaterWaveSpeed = 0
		Terrain.WaterReflectance = 0
	end)
end

--========================================================--
-- CHARACTER CHECK
--========================================================--

local function isOwnCharacter(obj)
	local character = Player.Character

	if not character then
		return false
	end

	return obj:IsDescendantOf(character)
end

--========================================================--
-- AUTO HILANGKAN POPUP IKAN
--========================================================--

local function hideFishPopup(obj)

	if not HIDE_FISH_POPUP then
		return
	end

	local name = string.lower(obj.Name)

	-- Kata yang umum digunakan pada popup hasil mancing
	if string.find(name, "fish")
		or string.find(name, "ikan")
		or string.find(name, "caught")
		or string.find(name, "catch")
		or string.find(name, "reward")
		or string.find(name, "rare")
		or string.find(name, "epic")
		or string.find(name, "legendary")
		or string.find(name, "secret")
		or string.find(name, "mythic") then

		if obj:IsA("ScreenGui")
			or obj:IsA("BillboardGui") then

			pcall(function()
				obj.Enabled = false
				obj:Destroy()
			end)

		elseif obj:IsA("TextLabel")
			or obj:IsA("ImageLabel")
			or obj:IsA("Frame") then

			pcall(function()
				obj.Visible = false
				obj:Destroy()
			end)

		end
	end
end

--========================================================--
-- SCAN POPUP YANG SUDAH ADA
--========================================================--

task.spawn(function()

	for _, obj in ipairs(game:GetDescendants()) do
		hideFishPopup(obj)
	end

end)

--========================================================--
-- REALTIME POPUP CLEANER
--========================================================--

game.DescendantAdded:Connect(function(obj)

	if not HIDE_FISH_POPUP then
		return
	end

	task.defer(function()
		hideFishPopup(obj)
	end)

end)

--========================================================--
-- WORLD OPTIMIZER
--========================================================--

local function optimizeWorldObject(obj)

	if isOwnCharacter(obj) then
		return
	end

	--================ VFX ================--

	if DISABLE_VFX then

		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles")
			or obj:IsA("Highlight") then

			pcall(function()
				obj.Enabled = false
			end)

			return
		end

	end

	--================ LIGHT ================--

	if DISABLE_LIGHTS then

		if obj:IsA("PointLight")
			or obj:IsA("SpotLight")
			or obj:IsA("SurfaceLight") then

			pcall(function()
				obj.Enabled = false
			end)

			return
		end

	end

	--================ TEXTURE ================--

	if HIDE_TEXTURES then

		if obj:IsA("Decal")
			or obj:IsA("Texture") then

			pcall(function()
				obj.Transparency = 1
			end)

			return
		end

		if obj:IsA("SurfaceAppearance") then

			pcall(function()
				obj.Enabled = false
			end)

			return
		end

	end

	--================ WORLD PART ================--

	if obj:IsA("BasePart") then

		pcall(function()

			if DISABLE_SHADOWS then
				obj.CastShadow = false
			end

			obj.Reflectance = 0
			obj.Material = Enum.Material.Plastic

			if WORLD_INVISIBLE then
				obj.LocalTransparencyModifier = WORLD_TRANSPARENCY
			end

		end)

	end

end

--========================================================--
-- INITIAL WORLD CLEAN
--========================================================--

local objects = Workspace:GetDescendants()

for i, obj in ipairs(objects) do

	optimizeWorldObject(obj)

	if i % 500 == 0 then
		task.wait()
	end

end

--========================================================--
-- INVISIBLE CHARACTER
--========================================================--

local function hideCharacter(character)

	if not HIDE_CHARACTER then
		return
	end

	for _, obj in ipairs(character:GetDescendants()) do

		if obj:IsA("Humanoid")
			or obj:IsA("HumanoidRootPart")
			or obj:IsA("Animator")
			or obj:IsA("Script")
			or obj:IsA("LocalScript") then

			continue
		end

		-- ACCESSORY
		if obj:IsA("Accessory") then

			if REMOVE_ACCESSORIES then

				pcall(function()
					obj:Destroy()
				end)

			end

		-- BODY
		elseif obj:IsA("BasePart") then

			pcall(function()
				obj.LocalTransparencyModifier = 1
				obj.CastShadow = false
			end)

		-- FACE / TEXTURE
		elseif obj:IsA("Decal")
			or obj:IsA("Texture") then

			pcall(function()
				obj.Transparency = 1
			end)

		-- CHARACTER VFX
		elseif obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Highlight") then

			pcall(function()
				obj.Enabled = false
			end)

		end

	end

end

--========================================================--
-- CHARACTER SETUP
--========================================================--

local function setupCharacter(character)

	task.wait(0.5)

	hideCharacter(character)

	character.DescendantAdded:Connect(function(obj)

		task.defer(function()

			if obj:IsA("BasePart") then

				pcall(function()
					obj.LocalTransparencyModifier = 1
					obj.CastShadow = false
				end)

			elseif obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam")
				or obj:IsA("Highlight") then

				pcall(function()
					obj.Enabled = false
				end)

			elseif obj:IsA("Accessory") then

				if REMOVE_ACCESSORIES then

					pcall(function()
						obj:Destroy()
					end)

				end

			end

		end)

	end)

end

if Player.Character then
	task.spawn(setupCharacter, Player.Character)
end

Player.CharacterAdded:Connect(setupCharacter)

--========================================================--
-- REALTIME WORLD CLEANER
--========================================================--

Workspace.DescendantAdded:Connect(function(obj)

	task.defer(function()

		if isOwnCharacter(obj) then
			return
		end

		optimizeWorldObject(obj)

	end)

end)

--========================================================--
-- PERIODIC VFX CLEANER
--========================================================--

task.spawn(function()

	while task.wait(2) do

		for _, obj in ipairs(Workspace:GetDescendants()) do

			if not isOwnCharacter(obj) then

				if obj:IsA("ParticleEmitter")
					or obj:IsA("Trail")
					or obj:IsA("Beam")
					or obj:IsA("Smoke")
					or obj:IsA("Fire")
					or obj:IsA("Sparkles")
					or obj:IsA("Highlight") then

					pcall(function()
						obj.Enabled = false
					end)

				elseif obj:IsA("PointLight")
					or obj:IsA("SpotLight")
					or obj:IsA("SurfaceLight") then

					pcall(function()
						obj.Enabled = false
					end)

				elseif obj:IsA("BasePart") then

					pcall(function()

						obj.CastShadow = false

						if WORLD_INVISIBLE then
							obj.LocalTransparencyModifier =
								WORLD_TRANSPARENCY
						end

					end)

				end

			end

		end

		if Player.Character then
			hideCharacter(Player.Character)
		end

	end

end)

